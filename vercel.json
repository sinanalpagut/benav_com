{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "headers": [
    {
      "source": "/app-ads.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ],
  "rewrites": [
    {
      "source": "/ios",
      "destination": "/ios.html"
    },
    {
      "source": "/katil/:kod",
      "destination": "/katil.html"
    },
    {
      "source": "/katil",
      "destination": "/katil.html"
    },
    {
      "source": "/destek/insaat-takip",
      "destination": "/destek/insaat-takip.html"
    }
  ]
}
